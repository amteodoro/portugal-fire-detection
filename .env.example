# App
APP_NAME=Portugal Fire Detection
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Portugal BBOX (lon_min,lat_min,lon_max,lat_max) - Mainland
PORTUGAL_BBOX=-9.5,36.8,-6.0,42.3

# Toggle background scheduler to limit usage in testing
SCHEDULER_ENABLED=false
TIMEZONE=Europe/Lisbon

# Cache TTLs (seconds)
FIRMS_TTL=900
EUMETSAT_TTL=1800
S2_TTL=86400

# NASA FIRMS - Sign up at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_API_KEY=your_firms_api_key_here

# EUMETSAT (WMS/WCS) - use public WMS if available; token optional
# Sign up at https://eoportal.eumetsat.int/
EUMETSAT_WMS_URL=https://view.eumetsat.int/geoserver/wms
EUMETSAT_FRP_LAYER=EO:EUM:DAT:MSG:FRP
EUMETSAT_TOKEN=

# Copernicus STAC (default to Earth Search for testing if no CDSE creds)
# Sign up at https://dataspace.copernicus.eu/ for official access
STAC_CATALOG_URL=https://earth-search.aws.element84.com/v1
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
